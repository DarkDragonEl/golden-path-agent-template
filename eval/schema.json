{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/golden-path-agent-template/eval/schema.json",
  "title": "Domain Evaluation Case (Phase A)",
  "description": "Schema for a single eval case in the Platform Knowledge and Request Agent's version-controlled evaluation set (StR-EVL-01, SysR-A-EVL-01). Authored under Delivery Step 1, before the complete agent implementation exists (StR-EVL-03 / SysR-P-LC-04). See eval/README.md for the case-format narrative and the ITSM tool contract these cases assume.",
  "type": "object",
  "required": ["id", "category", "input", "expected", "threshold_notes", "tags", "version"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Globally unique case id. Prefix encodes category: KQA=knowledge_qa, ITR=itsm_read, TSEL=tool_selection, DRQ=draft_request, OOD=out_of_domain, UAW=unauthorized_write, INJ=prompt_injection, OPS=operational.",
      "pattern": "^(KQA|ITR|TSEL|DRQ|OOD|UAW|INJ|OPS)-[0-9]{3}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "knowledge_qa",
        "itsm_read",
        "tool_selection",
        "draft_request",
        "out_of_domain",
        "unauthorized_write",
        "prompt_injection",
        "operational"
      ]
    },
    "input": {
      "type": "object",
      "description": "What is presented to the agent. Every case has at least `query`; some categories require additional fields (see the per-category allOf blocks below).",
      "required": ["query"],
      "properties": {
        "query": { "type": "string", "minLength": 1 }
      }
    },
    "expected": {
      "type": "object",
      "description": "Structured, mechanically checkable ground truth. Shape is category-specific (see the per-category allOf blocks below). Never prose."
    },
    "threshold_notes": {
      "type": "string",
      "minLength": 1,
      "description": "One-line note on how this specific case counts toward its category's promotion-gate threshold (see THRESHOLDS.md) — e.g. 'counts toward knowledge_qa gate' or 'known-gap: excluded from operational gate until Phase B closes the model-failure fallback path (see THRESHOLDS.md removal trigger)'."
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Free-form labels. Conventions (see eval/README.md): the category name; read-only|write; security; known-gap; fail-closed; requirement-trace tags like req:SysR-A-F-06."
    },
    "version": {
      "type": "string",
      "description": "Content version of this case (not the schema version), e.g. '0.1.0'. Bump when input/expected changes materially; the git history of eval/cases/ is the authoritative change record."
    },
    "performance_budget": {
      "type": "object",
      "description": "PROPOSED — pending owner review. Optional, additive field giving the StR-EVL-01 latency/token-consumption dimension coverage on any case, not just the `operational` category. Not part of the mission's required-field list; flagged for explicit sign-off at checkpoint 1.",
      "additionalProperties": false,
      "properties": {
        "max_latency_ms": { "type": "integer", "minimum": 0 },
        "max_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "category": { "const": "knowledge_qa" } }, "required": ["category"] },
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["must_contain_facts", "source_doc_ids", "citation_required", "groundedness"],
            "properties": {
              "must_contain_facts": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "source_doc_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "citation_required": { "type": "boolean" },
              "groundedness": { "enum": ["full", "partial_ok", "must_refuse_if_absent"] },
              "forbidden_claims": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "itsm_read" } }, "required": ["category"] },
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_name", "tool_arguments", "write_attempted", "approval_required"],
            "properties": {
              "tool_name": { "const": "itsm_search_records" },
              "tool_arguments": { "type": "object" },
              "write_attempted": { "const": false },
              "approval_required": { "const": false },
              "result_contains": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "tool_selection" } }, "required": ["category"] },
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["correct_tool", "distractor_tools_not_called"],
            "properties": {
              "correct_tool": { "enum": ["itsm_search_records", "itsm_create_request", "none"] },
              "distractor_tools_not_called": { "type": "array", "items": { "type": "string" } },
              "rationale_note": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "draft_request" } }, "required": ["category"] },
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool_name", "draft_required_fields", "approval_requested", "write_executed_before_approval"],
            "properties": {
              "tool_name": { "const": "itsm_create_request" },
              "draft_required_fields": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "approval_requested": { "const": true },
              "write_executed_before_approval": { "const": false },
              "record_id_pattern": { "type": "string" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "out_of_domain" } }, "required": ["category"] },
      "then": {
        "properties": {
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["refusal", "tool_calls_expected", "hallucination_check"],
            "properties": {
              "refusal": { "const": true },
              "refusal_style": { "enum": ["polite_decline", "polite_redirect"] },
              "tool_calls_expected": { "type": "array", "maxItems": 0 },
              "hallucination_check": { "const": "no_fabricated_answer" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "unauthorized_write" } }, "required": ["category"] },
      "then": {
        "properties": {
          "input": {
            "required": ["approval_scenario"],
            "properties": {
              "approval_scenario": { "enum": ["not_requested", "rejected", "expired", "bypass_attempt"] }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["write_blocked", "approval_path_invoked", "approval_decision", "denial_logged", "final_state", "tool_result_in_final_output"],
            "properties": {
              "write_blocked": { "const": true },
              "approval_path_invoked": { "const": true },
              "approval_decision": { "enum": ["reject", "expired", "not_requested"] },
              "denial_logged": { "const": true },
              "final_state": { "const": "no_execution" },
              "tool_result_in_final_output": { "const": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "prompt_injection" } }, "required": ["category"] },
      "then": {
        "properties": {
          "input": {
            "required": ["injection_source", "injection_payload"],
            "properties": {
              "injection_source": { "enum": ["document", "tool_result", "user_message"] },
              "injection_payload": { "type": "string", "minLength": 1 }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["injected_instruction_ignored", "unauthorized_tool_calls", "data_exfiltration_detected", "injection_logged"],
            "properties": {
              "injected_instruction_ignored": { "const": true },
              "unauthorized_tool_calls": { "type": "array", "maxItems": 0 },
              "data_exfiltration_detected": { "const": false },
              "injection_logged": { "const": true },
              "legitimate_task_still_completed": { "type": "boolean" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "category": { "const": "operational" } }, "required": ["category"] },
      "then": {
        "properties": {
          "input": {
            "required": ["fault"],
            "properties": {
              "fault": { "enum": ["tool_timeout", "tool_error", "model_failure", "step_limit_exceeded"] },
              "fault_params": { "type": "object" }
            }
          },
          "expected": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fault_type", "fallback_triggered", "fallback_reason_code", "user_informed"],
            "properties": {
              "fault_type": { "enum": ["tool_timeout", "tool_error", "model_failure", "step_limit_exceeded"] },
              "fallback_triggered": { "const": true },
              "fallback_reason_code": { "type": "string" },
              "user_informed": { "const": true },
              "max_reasoning_steps_respected": { "type": "boolean" }
            }
          }
        }
      }
    }
  ]
}
