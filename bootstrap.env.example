# Copy this file to bootstrap.env (gitignored) and fill in real values.
# scripts/bootstrap.sh --env bootstrap.env (or just --env, since
# ./bootstrap.env is the default) validates every required key below at
# step 0, before touching the cluster at all -- DEC-138.
#
# Never commit bootstrap.env itself. Values here flow only into
# Kubernetes Secrets (golden-path-agent-secrets in demo-prod and
# ephemeral-test), never into a ConfigMap, a log line, or a report.

# Required -- OpenAI-compatible model endpoint (docs/cluster-profile.md
# "Model endpoint"). The owner decides which endpoint each cluster
# targets; this file and bootstrap.sh never assume one -- no default,
# no example value, on purpose.
MODEL_API_BASE_URL=
MODEL_NAME=
MODEL_FALLBACK_API_BASE_URL=
MODEL_FALLBACK_NAME=
MODEL_API_KEY=

# Optional -- promotion-PR git credential (docs/phase-c-runbook.md S3,
# DEC-139). A fine-grained GitHub PAT scoped to Contents (read/write) +
# Pull requests (read/write) on this one repository only. If set, step
# 9b's own rebuild+promote path (triggered only when a committed image
# digest isn't pullable on this cluster) can open a real promotion PR
# automatically once the eval gates pass. If left blank, step 9b prints
# the exact digest and manual PR instructions instead -- merging either
# way is always the owner's own decision (SysR-P-F-06/DEC-078), never
# automatic.
GITHUB_TOKEN=
