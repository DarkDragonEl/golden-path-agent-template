# ARG, not a hardcoded pin: the enterprise-approved base image is supplied
# at build time per engagement/platform. This default is a plain, generic
# image so the scaffold builds and runs anywhere out of the box.
ARG BASE_IMAGE=python:3.12-slim
FROM ${BASE_IMAGE}

WORKDIR /opt/app-root/src

# Dependencies first (cache layer). Agent-only: langgraph/langchain-core/
# openai/pyyaml never load in the mcp or approval images (three-image
# split).
COPY requirements-agent.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Code only — never the corpus. The corpus is a mount, not a layer.
COPY agent/ ./agent/
COPY policy/ ./policy/
COPY corpus/ingest.py ./corpus/ingest.py
# Client-side surface only (agent/nodes/tool_invoke.py,
# agent/nodes/human_approval.py import mcp_server.client.call_tool) — NOT
# server.py/auth.py/schemas.py/itsm_store.py, which never load here.
# call_tool()'s `if mcp_mode == "mock":` branch does `from . import
# server`, which would ImportError since server.py isn't in this image —
# this image MUST run with MCP_MODE=live, never mock.
COPY mcp_server/__init__.py ./mcp_server/__init__.py
COPY mcp_server/client.py ./mcp_server/client.py
COPY --chmod=0755 entrypoint-agent.sh ./entrypoint.sh

ENV AGENT_CORPUS_DIR=/mnt/corpus \
    AGENT_STATE_DIR=/opt/app-root/src/state \
    AGENT_PORT=8080 \
    MCP_MODE=live

# Restricted-SCC-compatible: arbitrary non-root UID, group-writable, GID 0.
RUN mkdir -p "$AGENT_STATE_DIR" "$AGENT_CORPUS_DIR" \
    && chmod -R g=u /opt/app-root/src "$AGENT_CORPUS_DIR"

USER 1001
EXPOSE 8080
ENTRYPOINT ["./entrypoint.sh"]
