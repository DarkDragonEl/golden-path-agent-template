# Model endpoint (dev/shared endpoint locally; approved endpoint injected
# per environment via deploy/kustomize/base/configmap.yaml overlays).
MODEL_API_BASE_URL=http://localhost:11434/v1
MODEL_NAME=placeholder-model
MODEL_API_KEY=not-needed
AGENT_MODEL_MODE=live          # live | fake (fake = deterministic, no network)

# MCP tool contract. MCP_TOOL_ENDPOINT here is only used when running
# agent/mcp_server outside containers (pytest, `python -m agent.cli`,
# etc.) — scripts/dev.sh always overrides it to the container-network
# address (http://golden-path-agent-mcp-dev:8081) when running via
# `make up`/`make up-offline`, since "localhost" wouldn't reach a sibling
# container.
MCP_TOOL_ENDPOINT=http://localhost:8081
MCP_MODE=mock                  # mock | live
MCP_HOST=0.0.0.0
MCP_PORT=8081                  # in-container port — leave as-is

# Host-published ports for scripts/dev.sh (`make up` / `make up-offline`).
# Default to 18080/18081 rather than 8080/8081, since those two are common
# enough for other local infra (registries, identity servers, ...) to
# already be running on a dev box. Change these if 18080/18081 collide too.
AGENT_HOST_PORT=18080
MCP_HOST_PORT=18081

# Retrieval / data source (TODO(domain): real binding per environment)
DATA_SOURCE_BINDING=none
AGENT_CORPUS_DIR=./corpus/seed

# Policy bundle + constrained-agent guardrails
POLICY_BUNDLE_REF=policy/baseline_policy.yaml
MAX_REASONING_STEPS=5
TOOL_TIMEOUT_SECONDS=10
TOOL_RETRY_LIMIT=2
APPROVAL_MODE=required          # required | auto
AUTO_APPROVE_IN_DEV=false       # dev-only convenience; never true in staging/pilot-prod

# Telemetry (unset = telemetry disabled locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=golden-path-agent

# Ports
AGENT_PORT=8080
