# DEC-145 (M16): the Gitea scaffolder dynamic plugin RHDH loads. The image
# lives in an external registry chosen per adopter (RHDH_PLUGIN_REGISTRY,
# bootstrap.env) and is referenced only by this digest -- never a tag,
# never a hostname in Git. Written by ./build.sh --write-pin after a push;
# PINS.md carries the same digest (tests/test_rhdh_plugin_pins.py).
# Empty PLUGIN_DIGEST = not built yet: bootstrap --with-rhdh refuses to start.
PLUGIN_IMAGE_NAME=backstage-plugin-scaffolder-backend-module-gitea
PLUGIN_VERSION=0.2.19
PLUGIN_DIGEST=
